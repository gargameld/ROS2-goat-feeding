# Ignore everything in this repository by default.
/*

# Keep the ignore rules themselves in the repository.
!/.gitignore

# Keep the container build definition.
!/Dockerfile
/docker/

# Keep the repository documentation and its media.
!/README.md
!/media/
!/media/**

# Keep the ROS source tree and simulation model sources.
!/workspace/
/workspace/*
!/workspace/src/
!/workspace/src/**
!/workspace/mujoco_model/
!/workspace/mujoco_model/**
/workspace/mujoco_model/live_view*/

# Ignore saved simulation states.
/workspace/important states/

# Keep all Python modules in capture, but ignore generated captures and the local environment.
!/workspace/capture/
/workspace/capture/*
!/workspace/capture/**/
!/workspace/capture/**/*.py

# ROS 2 / colcon generated output.
/workspace/build/
/workspace/install/
/workspace/log/
/workspace/MUJOCO_LOG.TXT

# Python generated files and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
*.egg-info/

# Test, profiling, and runtime artifacts.
*.log
*.prof
*.trace
core
core.*
rosbag2_*/
*.bag
*.db3
*.mcap

# Editor and operating-system metadata.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*:Zone.Identifier
