# Ignore everything in this repository by default.
/*

# Keep the ignore rules themselves in the repository.
!/.gitignore

# Keep only the ROS source tree.
!/workspace/
/workspace/*
!/workspace/src/
!/workspace/src/**

# Keep important saved simulation states.
!/workspace/important states/
!/workspace/important states/**

# Keep the capture rendering utility, but ignore generated captures and its local environment.
!/workspace/capture/
/workspace/capture/*
!/workspace/capture/render_capture.py

# Python bytecode caches.
__pycache__/
*.py[cod]
