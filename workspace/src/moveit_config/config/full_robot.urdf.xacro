<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="full_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import full_robot urdf file -->
    <xacro:include filename="$(find robot_description)/urdf/full_robot.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="full_robot.ros2_control.xacro" />


    <xacro:full_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
