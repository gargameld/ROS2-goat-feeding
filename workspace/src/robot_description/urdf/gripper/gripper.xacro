<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Custom parallel-jaw gripper.

       Frame convention (shared with arm_tool0, which this macro mounts to):
         +Z is the approach axis, pointing away from the wrist flange.
         +X is the binormal, i.e. the direction the jaws close along. The grasp
            pose provider builds TCP orientations with the GPD binormal as TCP
            +X (grasp_config_conversion.py), so the jaws must travel along +/-X.
         +Y is the remaining hand axis, the direction the jaws are long in.

       Stack, from the flange outwards:
         z in [0, 0.01]  mount disc, radius = the UR5e tool flange radius
         z in [0.01, 0.02] palm plate, 0.13 along X (closing) x 0.07 along Y
         z in [0.02, 0.10] the two jaw plates, 0.01 thick along X, 0.07 long
                           along Y, 0.08 tall

       Both jaws are driven off a single actuated joint: right_finger_joint
       mimics finger_joint 1:1, so each jaw always sits the same distance in
       from its own edge of the palm plate. The MJCF mirrors that with an
       equality constraint between the same two joint names. -->
  <xacro:macro name="parallel_gripper" params="">

    <!-- UR5e tool flange radius (63 mm diameter). -->
    <xacro:property name="mount_radius" value="0.0315"/>
    <xacro:property name="mount_height" value="0.01"/>

    <!-- Palm plate: 0.13 along the closing axis, 0.07 across it. -->
    <xacro:property name="palm_x" value="0.13"/>
    <xacro:property name="palm_y" value="0.07"/>
    <xacro:property name="palm_z" value="0.01"/>

    <!-- Jaw plate: 0.01 thick along the closing axis, 0.07 long to match the
         palm it sits on, 0.08 tall. -->
    <xacro:property name="jaw_x" value="0.01"/>
    <xacro:property name="jaw_y" value="0.07"/>
    <xacro:property name="jaw_z" value="0.08"/>

    <!-- Jaw travel. At finger_joint = 0 each jaw's outer face is flush with
         its edge of the palm, leaving an opening of palm_x - 2*jaw_x = 0.11 m.
         At the upper limit the two inner faces meet on the palm centre line. -->
    <xacro:property name="jaw_stroke" value="${palm_x / 2 - jaw_x}"/>

    <xacro:property name="palm_mass" value="0.5"/>
    <xacro:property name="jaw_mass" value="0.05"/>

    <material name="gripper_body_gray">
      <color rgba="0.25 0.25 0.25 1"/>
    </material>
    <material name="gripper_jaw_gray">
      <color rgba="0.55 0.55 0.55 1"/>
    </material>

    <link name="gripper_base_link">
      <!-- Lumped inertia of the disc plus palm, approximated as a single
           solid box spanning z in [0, mount_height + palm_z]. -->
      <inertial>
        <origin xyz="0 0 ${(mount_height + palm_z) / 2}" rpy="0 0 0"/>
        <mass value="${palm_mass}"/>
        <inertia
          ixx="${palm_mass / 12 * (palm_y * palm_y + (mount_height + palm_z) * (mount_height + palm_z))}"
          ixy="0.0"
          ixz="0.0"
          iyy="${palm_mass / 12 * (palm_x * palm_x + (mount_height + palm_z) * (mount_height + palm_z))}"
          iyz="0.0"
          izz="${palm_mass / 12 * (palm_x * palm_x + palm_y * palm_y)}"/>
      </inertial>

      <visual>
        <origin xyz="0 0 ${mount_height / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${mount_radius}" length="${mount_height}"/>
        </geometry>
        <material name="gripper_body_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${mount_height / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${mount_radius}" length="${mount_height}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 ${mount_height + palm_z / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="${palm_x} ${palm_y} ${palm_z}"/>
        </geometry>
        <material name="gripper_body_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${mount_height + palm_z / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="${palm_x} ${palm_y} ${palm_z}"/>
        </geometry>
      </collision>
    </link>

    <!-- Jaw macro. reflect = +1 for the jaw on the +X edge of the palm,
         -1 for the one on the -X edge. The link origin sits on the palm's
         top face at the jaw's fully open position, and the joint axis points
         inwards, so a positive joint value closes the gripper on both sides. -->
    <xacro:macro name="gripper_jaw" params="name reflect">
      <link name="${name}">
        <inertial>
          <origin xyz="${-reflect * jaw_x / 2} 0 ${jaw_z / 2}" rpy="0 0 0"/>
          <mass value="${jaw_mass}"/>
          <inertia
            ixx="${jaw_mass / 12 * (jaw_y * jaw_y + jaw_z * jaw_z)}"
            ixy="0.0"
            ixz="0.0"
            iyy="${jaw_mass / 12 * (jaw_x * jaw_x + jaw_z * jaw_z)}"
            iyz="0.0"
            izz="${jaw_mass / 12 * (jaw_x * jaw_x + jaw_y * jaw_y)}"/>
        </inertial>
        <visual>
          <origin xyz="${-reflect * jaw_x / 2} 0 ${jaw_z / 2}" rpy="0 0 0"/>
          <geometry>
            <box size="${jaw_x} ${jaw_y} ${jaw_z}"/>
          </geometry>
          <material name="gripper_jaw_gray"/>
        </visual>
        <collision>
          <origin xyz="${-reflect * jaw_x / 2} 0 ${jaw_z / 2}" rpy="0 0 0"/>
          <geometry>
            <box size="${jaw_x} ${jaw_y} ${jaw_z}"/>
          </geometry>
        </collision>
      </link>
    </xacro:macro>

    <xacro:gripper_jaw name="left_jaw_link" reflect="1"/>
    <xacro:gripper_jaw name="right_jaw_link" reflect="-1"/>

    <!-- The single actuated degree of freedom. gripper_controller
         (position_controllers/GripperActionController) commands this joint;
         0 is fully open and jaw_stroke is fully closed. -->
    <joint name="finger_joint" type="prismatic">
      <origin xyz="${palm_x / 2} 0 ${mount_height + palm_z}" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="left_jaw_link"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0" upper="${jaw_stroke}" velocity="0.15" effort="100"/>
    </joint>

    <!-- Mimicking finger_joint 1:1 with the mirrored axis is what keeps both
         jaws equidistant from their own edge of the palm. -->
    <joint name="right_finger_joint" type="prismatic">
      <origin xyz="${-palm_x / 2} 0 ${mount_height + palm_z}" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="right_jaw_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="${jaw_stroke}" velocity="0.15" effort="100"/>
      <mimic joint="finger_joint" multiplier="1" offset="0"/>
    </joint>

  </xacro:macro>

</robot>
