<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mujoco_ros2_control_config">
    <ros2_control name="MujocoSystem" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">/config/workspace/mujoco_model/scene.xml</param>
        <param name="write_frequency">100</param>
        <param name="physics_sync_safety_interval">0</param>
        <param name="extra_wait_time">4</param>
        <param name="required_active_controllers">joint_state_broadcaster,imu_sensor_broadcaster,mecanum_drive_controller,arm_trajectory_controller,gripper_controller</param>
        <!-- All MuJoCo camera streams are rendered and published at this rate. -->
        <param name="camera_publish_rate">1.0</param>
      </hardware>

      <!-- Four Wheel Joints -->
      <joint name="fl_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="fr_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="rl_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="rr_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- UR5e joints for joint_trajectory_controller. -->
      <joint name="arm_shoulder_pan_joint">
        <command_interface name="position">
          <param name="min">-6.283185307179586</param>
          <param name="max">6.283185307179586</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_shoulder_lift_joint">
        <command_interface name="position">
          <param name="min">-6.283185307179586</param>
          <param name="max">6.283185307179586</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_elbow_joint">
        <command_interface name="position">
          <param name="min">-6.28318530717958</param>
          <param name="max">6.28318530717958</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_wrist_1_joint">
        <command_interface name="position">
          <param name="min">-6.283185307179586</param>
          <param name="max">6.283185307179586</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_wrist_2_joint">
        <command_interface name="position">
          <param name="min">-6.283185307179586</param>
          <param name="max">6.283185307179586</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_wrist_3_joint">
        <command_interface name="position">
          <param name="min">-6.283185307179586</param>
          <param name="max">6.283185307179586</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Gripper Joint -->
      <joint name="finger_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.725</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Complete IMU state interface for imu_sensor_broadcaster. -->
      <sensor name="imu_sensor">
        <param name="mujoco_type">imu</param>
        <param name="mujoco_sensor_name">imu_sensor</param>
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>

      <!-- Front-facing MuJoCo camera (robot.xml: robot_camera). -->
      <sensor name="robot_camera">
        <param name="frame_name">front_camera_frame</param>
        <param name="pointcloud_topic">/front_camera/points</param>
      </sensor>

      <!-- The left-facing MuJoCo camera trio (robot.xml: left_camera /
           left_front_camera / left_back_camera). The grasp pose provider
           merges all three of these clouds into left_camera_frame. -->
      <sensor name="left_camera">
        <param name="frame_name">left_camera_frame</param>
        <param name="pointcloud_topic">/left_camera/points</param>
      </sensor>

      <sensor name="left_front_camera">
        <param name="frame_name">left_front_camera_frame</param>
        <param name="pointcloud_topic">/left_front_camera/points</param>
      </sensor>

      <sensor name="left_back_camera">
        <param name="frame_name">left_back_camera_frame</param>
        <param name="pointcloud_topic">/left_back_camera/points</param>
      </sensor>
    </ros2_control>
  </xacro:macro>

</robot>
