<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_with_gripper">

  <!-- Include the UR5e arm xacro -->
  <xacro:include filename="$(find robot_description)/urdf/arm.xacro"/>

  <!-- Include the custom parallel-jaw gripper xacro -->
  <xacro:include filename="$(find robot_description)/urdf/gripper/gripper.xacro"/>
  <xacro:parallel_gripper/>

  <!-- Attach the gripper base to the UR5e tool frame. The gripper macro is
       authored in the tool0 convention (+Z approach, +X closing), so this is
       an identity transform. -->
  <joint name="tool0_to_gripper_base" type="fixed">
    <parent link="arm_tool0"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
