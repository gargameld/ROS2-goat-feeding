<mujocoinclude>
  <asset>
    <mesh name="box" file="food_items_stl_files/box.stl" scale="0.001 0.001 0.001"/>
    <mesh name="cone" file="food_items_stl_files/cone.stl" scale="0.001 0.001 0.001"/>
    <mesh name="elipsoid" file="food_items_stl_files/elipsoid.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ring" file="food_items_stl_files/ring.stl" scale="0.001 0.001 0.001"/>
  </asset>
  <worldbody>
    <!-- Body names carry the "food_" prefix so StateCapturePlugin can detect
         these free-floating STL meshes and log their world poses.

         condim="6" is load-bearing: an arbitrary convex mesh resting on a flat
         primitive yields a single MPR contact point on the object's own spin
         axis, where sliding friction sees zero slip and so cannot resist
         rotation. Torsional friction can, but it is only simulated at
         condim >= 4 (rolling friction, which the ellipsoid and ring need, at
         6). At the inherited default of 3 an item settles and then yaws
         forever at whatever rate the landing impact left it with.

         No priority attribute: with equal priority MuJoCo takes condim = max
         and friction = elementwise max, so these win over the shelf/floor
         geoms while the gripper pads (priority="1") still fully own grasp
         contacts. -->
    <body name="food_box" pos="50 50 0.0545">
      <freejoint name="box_free"/>
      <geom name="box" type="mesh" mesh="box" pos="0.037 0.0415 -0.0495" condim="6" friction="1 0.02 0.002" rgba="0.85 0.6 0.2 1"/>
    </body>
    <body name="food_cone" pos="51 50 0.023">
      <freejoint name="cone_free"/>
      <geom name="cone" type="mesh" mesh="cone" pos="0.017 0.009 -0.018" condim="6" friction="1 0.02 0.002" rgba="0.85 0.6 0.2 1"/>
    </body>
    <body name="food_elipsoid" pos="52 50 0.0265">
      <freejoint name="elipsoid_free"/>
      <geom name="elipsoid" type="mesh" mesh="elipsoid" pos="-0.0275 0.034 -0.0215" condim="6" friction="1 0.02 0.002" rgba="0.85 0.6 0.2 1"/>
    </body>
    <body name="food_ring" pos="53 50 0.02025">
      <freejoint name="ring_free"/>
      <geom name="ring" type="mesh" mesh="ring" pos="0.034 -0.008 -0.01525" condim="6" friction="1 0.02 0.002" rgba="0.85 0.6 0.2 1"/>
    </body>
  </worldbody>
</mujocoinclude>
