<mujoco>
  <worldbody>
    <light diffuse=".5 .5 .5"/>
    <body name="chassis" pos="0 0 0.26" childclass="robot">
      <freejoint/>
      <body name="arm_mount" pos="0 0 0.10">
        <include file="mounted_arm.xml"/>
      </body>
      <!-- The mobile platform carries a 26 kg wheel set plus the UR5e arm.
           A 10 kg chassis let arm and contact reactions displace the base
           while it was supposed to be stationary. -->
      <geom type="box" size="0.5 0.40 0.05" pos="0 0 0.14" mass="40"/>
      <site name="imu_sensor" pos="0 0 0.200" size="0.015"/>

      <site name="front_lidar" pos="0.4 0 0.2" size="0.01"/>
      <site name="back_lidar" pos="-0.4 0 0.2" euler="0 0 180" size="0.01"/>
      

      <!-- 320x240 keeps software-rendered RGB-D frames below the DDS message
           and processing bottleneck seen with 640x480 in the headless container. -->
      <!-- Look along chassis +X, tilted 30 deg downward (rotation about +Y).
           MuJoCo camera +X is image-right, +Y is image-up, and -Z is the
           viewing direction. Must match front_camera_joint in full_robot.xacro. -->
      <camera name="robot_camera" mode="fixed" pos="0.5 0 0.38"
              xyaxes="0 -1 0  0.5 0 0.866025" resolution="320 240"/>

      <site name = "camera_site" pos = "0.5 0 0.38"/>

      <!-- A trio of cameras on the chassis +Y (left) edge, where the box
           half-size is 0.40, all at robot_camera's height. left_camera looks
           straight along chassis +Y, tilted 30 deg downward; left_front_camera
           and left_back_camera sit 0.3 m fore and aft of it and are each yawed
           30 deg about the chassis +Z axis back towards left_camera, so the
           three views together cover the sides of the food that a single
           head-on view occludes. Must match left_camera_joint /
           left_front_camera_joint / left_back_camera_joint in
           full_robot.xacro. -->
      <camera name="left_camera" mode="fixed" pos="0 0.4 0.38"
              xyaxes="1 0 0  0 0.5 0.866025" resolution="320 240"/>

      <site name="left_camera_site" pos="0 0.4 0.38"/>

      <camera name="left_front_camera" mode="fixed" pos="0.3 0.4 0.38"
              xyaxes="0.866025 0.5 0  -0.25 0.433013 0.866025" resolution="320 240"/>

      <site name="left_front_camera_site" pos="0.3 0.4 0.38"/>

      <camera name="left_back_camera" mode="fixed" pos="-0.3 0.4 0.38"
              xyaxes="0.866025 -0.5 0  0.25 0.433013 0.866025" resolution="320 240"/>

      <site name="left_back_camera_site" pos="-0.3 0.4 0.38"/>

      <!--
        The chassis is forward along local +X and left along local +Y.  Keep
        each physical corner paired with its similarly named joint so the
        mecanum_drive_controller's direct fl/fr/rl/rr mapping is valid.
      -->
      <body pos="0.35 0.25 -0.1">
        <include file="front_left_wheel.xml"/>
      </body>

      <body pos="-0.35 0.25 -0.1">
        <include file="rear_left_wheel.xml"/>
      </body>

      <body pos="0.35 -0.25 -0.1">
        <include file="front_right_wheel.xml"/>
      </body>

      <body pos="-0.35 -0.25 -0.1">
        <include file="rear_right_wheel.xml"/>
      </body>

    </body>
  </worldbody>

  <sensor>
    <framequat name="imu_sensor_quat" objtype="site" objname="imu_sensor"/>
    <gyro name="imu_sensor_gyro" site="imu_sensor" noise="0.001"/>
    <accelerometer name="imu_sensor_accel" site="imu_sensor" noise="0.01"/>
  </sensor>

  <actuator>
    <!-- Native wheel-velocity servos for mecanum_drive_controller. The higher
         gain supplies enough drive and zero-speed holding torque for the
         heavier chassis without using an excessively stiff wheel servo. -->
    <velocity name="motor_fr" joint="fr_wheel_joint" kv="25"/>
    <velocity name="motor_fl" joint="fl_wheel_joint" kv="25"/>
    <velocity name="motor_rr" joint="rr_wheel_joint" kv="25"/>
    <velocity name="motor_rl" joint="rl_wheel_joint" kv="25"/>
    <include file="arm_actuators.xml"/>
  </actuator>

  <include file="back_lidar.xml"/>
  <include file="front_lidar.xml"/>


</mujoco>
