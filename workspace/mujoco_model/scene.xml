<mujoco>
  <option cone="elliptic" impratio="10"/>
  <option timestep="0.001" iterations="10"/>

  <!-- The food items park at x~50 y~50, so the auto-computed model bounding box
       is 63 m across. MuJoCo scales the clipping planes by stat.extent, which
       put near at znear*63 = 0.63 m: the whole robot sat inside the near plane
       and on-board cameras rendered straight through the chassis. Pinning the
       extent to arena scale gives near = 0.02 m and far = 100 m. mujoco_cameras
       reads the same two values when it linearizes the depth buffer. -->
  <statistic extent="2" center="0 0 0.5"/>
  <visual>
    <quality shadowsize="0"/>
    <global realtime="0.1"/>
  </visual>
  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.62 0.78 0.95" rgb2="0.93 0.97 1" width="512" height="512"/>
    <texture name="tex_floor_grid" type="2d" builtin="checker" rgb1="0.72 0.76 0.78" rgb2="0.42 0.46 0.48" width="512" height="512"/>

    <texture name="tex_black" builtin="flat" height="32" width="32" rgb1="0 0 0" type="2d"/>
    <texture name="tex_magenta" builtin="flat" height="32" width="32" rgb1="1 0 1" type="2d"/>
    <texture name="tex_red" builtin="flat" height="32" width="32" rgb1="1 0 0" type="2d"/>
    <texture name="tex_blue" builtin="flat" height="32" width="32" rgb1="0 0 1" type="2d"/>

    <material name="mat_black" texture="tex_black"/>
    <material name="mat_magenta" texture="tex_magenta"/>
    <material name="mat_red" texture="tex_red"/>
    <material name="mat_blue" texture="tex_blue"/>
    <material name="mat_floor_grid" texture="tex_floor_grid" texrepeat="24 24" reflectance="0.28" specular="0.35" shininess="0.45"/>
    <material name="arm_black" rgba="0.033 0.033 0.033 1" specular="0.5" shininess="0.25"/>
    <material name="arm_jointgray" rgba="0.278 0.278 0.278 1" specular="0.5" shininess="0.25"/>
    <material name="arm_linkgray" rgba="0.82 0.82 0.82 1" specular="0.5" shininess="0.25"/>
    <material name="arm_urblue" rgba="0.49 0.678 0.8 1" specular="0.5" shininess="0.25"/>

    <mesh name="base_0" file="meshes/base_0.obj"/>
    <mesh name="base_1" file="meshes/base_1.obj"/>
    <mesh name="shoulder_0" file="meshes/shoulder_0.obj"/>
    <mesh name="shoulder_1" file="meshes/shoulder_1.obj"/>
    <mesh name="shoulder_2" file="meshes/shoulder_2.obj"/>
    <mesh name="upperarm_0" file="meshes/upperarm_0.obj"/>
    <mesh name="upperarm_1" file="meshes/upperarm_1.obj"/>
    <mesh name="upperarm_2" file="meshes/upperarm_2.obj"/>
    <mesh name="upperarm_3" file="meshes/upperarm_3.obj"/>
    <mesh name="forearm_0" file="meshes/forearm_0.obj"/>
    <mesh name="forearm_1" file="meshes/forearm_1.obj"/>
    <mesh name="forearm_2" file="meshes/forearm_2.obj"/>
    <mesh name="forearm_3" file="meshes/forearm_3.obj"/>
    <mesh name="wrist1_0" file="meshes/wrist1_0.obj"/>
    <mesh name="wrist1_1" file="meshes/wrist1_1.obj"/>
    <mesh name="wrist1_2" file="meshes/wrist1_2.obj"/>
    <mesh name="wrist2_0" file="meshes/wrist2_0.obj"/>
    <mesh name="wrist2_1" file="meshes/wrist2_1.obj"/>
    <mesh name="wrist2_2" file="meshes/wrist2_2.obj"/>
    <mesh name="wrist3" file="meshes/wrist3.obj"/>
  </asset>



  <default>
    <!-- Robot geoms use group 1 so robot-mounted lidars can ignore self
         returns while continuing to raycast environment geoms in group 0. -->
    <default class="robot">
      <geom group="1"/>
    </default>
  </default>

  <include file="robot.xml"/>
  <include file="food_loader.xml"/>

  <worldbody>
    <light pos="0 -3 6" dir="0 0 -1" diffuse="0.7 0.7 0.7" specular="0.25 0.25 0.25"/>
    <geom type="plane" size="100 100 0.1" pos="0 0 0" material="mat_floor_grid"/>
    <geom name="obstacle" type="box" size="0.4 0.4 0.5" pos="-2 -7.5 0.5" rgba="0.85 0.38 0.12 1"/>

    <body name="quoridor" pos="0 4 0">
      <!-- Black wall, centered hole at z=0.25. -->
      <geom type="box" size="0.05 0.875 0.5" pos="-2.5 0.875 0.5" material="mat_black"/>
      <geom type="box" size="0.05 0.875 0.5" pos="-2.5 3.125 0.5" material="mat_black"/>
      <geom type="box" size="0.05 0.25 0.035" pos="-2.5 2 0.035" material="mat_black"/>
      <geom type="box" size="0.05 0.25 0.285" pos="-2.5 2 0.715" material="mat_black"/>

      <!-- Magenta wall, centered hole at z=0.40. -->
      <geom type="box" size="0.05 0.875 0.5" pos="-2.5 -3.125 0.5" material="mat_magenta"/>
      <geom type="box" size="0.05 0.875 0.5" pos="-2.5 -0.875 0.5" material="mat_magenta"/>
      <geom type="box" size="0.05 0.25 0.11" pos="-2.5 -2 0.11" material="mat_magenta"/>
      <geom type="box" size="0.05 0.25 0.21" pos="-2.5 -2 0.79" material="mat_magenta"/>

      <!-- Red wall, centered hole at z=0.55. -->
      <geom type="box" size="0.05 0.875 0.5" pos="2.5 0.875 0.5" material="mat_red"/>
      <geom type="box" size="0.05 0.875 0.5" pos="2.5 3.125 0.5" material="mat_red"/>
      <geom type="box" size="0.05 0.25 0.185" pos="2.5 2 0.185" material="mat_red"/>
      <geom type="box" size="0.05 0.25 0.135" pos="2.5 2 0.865" material="mat_red"/>

      <!-- Blue wall, centered hole at z=0.70. -->
      <geom type="box" size="0.05 0.875 0.5" pos="2.5 -3.125 0.5" material="mat_blue"/>
      <geom type="box" size="0.05 0.875 0.5" pos="2.5 -0.875 0.5" material="mat_blue"/>
      <geom type="box" size="0.05 0.25 0.26" pos="2.5 -2 0.26" material="mat_blue"/>
      <geom type="box" size="0.05 0.25 0.06" pos="2.5 -2 0.94" material="mat_blue"/>
      <geom type="box" size="2.5 0.05 0.5" pos="0 4 0.5"/>
    </body>

    <body name="parkings" pos="0 -4 0">
      <geom type="box" size="0.05 4 0.5" pos="-2.5 0 0.5"/>
      <geom type="box" size="2.5 0.05 0.5" pos="0 -4 0.5"/>

      <body name="parking1" pos="2.5 -3 0">
        <geom type="box" size="0.3 0.05 0.5" pos="0.25 0.7 0.5"/>
        <geom type="box" size="0.3 0.05 0.5" pos="0.25 -0.7 0.5"/>
        <geom type="box" size="0.05 0.7 0.5" pos="0.5 0 0.5" material="mat_blue"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 -0.85 0.5"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 0.85 0.5"/>
        <geom name="parking1_shelf" type="box" size="0.25 0.8 0.025" pos="0.25 0 0.275"/>
        <geom name="parking1_shelf_ceiling" type="box" size="0.25 0.8 0.025" pos="0.2 0 0.975"/>
        <geom name="parking1_shelf_wall" type="box" size="0.05 0.8 0.2" pos="0.0 0 0.1"/>
      </body>
      <body name="parking2" pos="2.5 -1 0">
        <geom type="box" size="0.3 0.05 0.5" pos="0.25 0.7 0.5"/>
        <geom type="box" size="0.3 0.05 0.5" pos="0.25 -0.7 0.5"/>
        <geom type="box" size="0.05 0.7 0.5" pos="0.5 0 0.5" material="mat_red"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 -0.85 0.5"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 0.85 0.5"/>
        <geom name="parking2_shelf" type="box" size="0.25 0.8 0.025" pos="0.25 0 0.275"/>
        <geom name="parking2_shelf_ceiling" type="box" size="0.25 0.8 0.025" pos="0.2 0 0.975"/>
        <geom name="parking2_shelf_wall" type="box" size="0.05 0.8 0.2" pos="0.0 0 0.1"/>
      </body>

      <body name="parking3" pos="2.5 1 0">
        <geom type="box" size="0.3 0.05 0.5" pos="0.25 0.7 0.5"/>
        <geom type="box" size="0.3 0.05 0.5" pos="0.25 -0.7 0.5"/>
        <geom type="box" size="0.05 0.7 0.5" pos="0.5 0 0.5" material="mat_black"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 -0.85 0.5"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 0.85 0.5"/>
        <geom name="parking3_shelf" type="box" size="0.25 0.8 0.025" pos="0.25 0 0.275"/>
        <geom name="parking3_shelf_ceiling" type="box" size="0.25 0.8 0.025" pos="0.2 0 0.975"/>
        <geom name="parking3_shelf_wall" type="box" size="0.05 0.8 0.2" pos="0.0 0 0.1"/>
      </body>

      <body name="parking4" pos="2.5 3 0">
        <geom type="box" size="0.3 0.05 0.5" pos="0.25 0.7 0.5"/>
        <geom type="box" size="0.3 0.05 0.5" pos="0.25 -0.7 0.5"/>
        <geom type="box" size="0.05 0.7 0.5" pos="0.5 0 0.5" material="mat_magenta"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 -0.85 0.5"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 0.85 0.5"/>
        <geom name="parking4_shelf" type="box" size="0.25 0.8 0.025" pos="0.25 0 0.275"/>
        <geom name="parking4_shelf_ceiling" type="box" size="0.25 0.8 0.025" pos="0.2 0 0.975"/>
        <geom name="parking4_shelf_wall" type="box" size="0.05 0.8 0.2" pos="0.0 0 0.1"/>
      </body>

    </body>
  </worldbody>
  <contact>
    <exclude body1="arm_base" body2="shoulder_link"/>
  </contact>

  <!-- The mirror of the URDF's <mimic joint="finger_joint"> on
       right_finger_joint (gripper.xacro): both jaws travel the same distance
       in from their own edge of the palm plate, so the grasp stays centred on
       the palm centre line. -->
  <equality>
    <joint joint1="finger_joint" joint2="right_finger_joint" polycoef="0 1 0 0 0"
      solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!-- Native position servo for gripper_controller
       (position_controllers/GripperActionController, joint: finger_joint).
       mujoco_ros2_control binds the ros2_control joint to the MuJoCo actuator
       driving the identically named joint, so this name must stay in step with
       mujoco_config.xacro. Driving finger_joint alone is enough; the equality
       above carries right_finger_joint along. ctrlrange spans fully open (0)
       to the jaws meeting on the centre line (0.055) and must match the
       finger_joint command_interface limits. -->
  <actuator>
    <position name="finger_joint" joint="finger_joint" kp="50000" dampratio="1"
      ctrllimited="true" ctrlrange="0 0.055"
      forcelimited="true" forcerange="-10000 10000"/>
  </actuator>

</mujoco>
